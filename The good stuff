local calibrationOn = false
local calibrationRemote = nil
local originalCallback = nil
local calibrationHook = function()
	return "supercomplete"
end

local function readCallback(remote)
	if getcallbackvalue then
		local ok, cb = pcall(getcallbackvalue, remote, "OnClientInvoke")
		if ok then return cb end
	end
	return nil
end

local function setCalibration(state)
	if state then
		local events = ReplicatedStorage:WaitForChild("Events", 3)
		local remote = events and events:WaitForChild("SkillcheckUpdate", 3)
		if not remote then
			warn("[ESP] SkillcheckUpdate not found")
			return false
		end

		calibrationRemote = remote
		originalCallback = readCallback(remote)
		local ok, err = pcall(function()
			remote.OnClientInvoke = calibrationHook
		end)
		if not ok then
			warn("[ESP] couldn't set callback:", err)
			return false
		end
		calibrationOn = true
		print("[ESP] Automatic Calibration ON")
	else
		calibrationOn = false
		if calibrationRemote then
			pcall(function()
				calibrationRemote.OnClientInvoke = originalCallback
			end)
		end
		print("[ESP] Automatic Calibration OFF")
	end
end

task.spawn(function()
	while true do
		task.wait(1)
		if calibrationOn and calibrationRemote then
			if readCallback(calibrationRemote) ~= calibrationHook then
				pcall(function()
					calibrationRemote.OnClientInvoke = calibrationHook
				end)
			end
		end
	end
end)

