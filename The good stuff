local function updateLabel(cat)
	local count = 0
	for _ in pairs(cat.highlights) do count += 1 end
	cat.labelObj.Text = cat.label .. " (" .. count .. ")"
end

local function addHighlight(obj)
	for _, cat in ipairs(categories) do
		if not cat.highlights[obj] and cat.names[obj.Name:lower()] then
			local valid = obj:IsA("Model") or (not cat.modelsOnly and obj:IsA("BasePart"))
			if valid then
				local h = Instance.new("Highlight")
				h.Adornee = obj
				h.FillColor = cat.color
				h.FillTransparency = 0.5
				h.OutlineColor = Color3.new(1, 1, 1)
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Enabled = cat.enabled
				h.Parent = gui

				cat.highlights[obj] = h
				updateLabel(cat)
			end
		end
	end
end

local function removeHighlight(obj)
	for _, cat in ipairs(categories) do
		local h = cat.highlights[obj]
		if h then
			h:Destroy()
			cat.highlights[obj] = nil
			updateLabel(cat)
		end
	end
end

