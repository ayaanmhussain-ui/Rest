local tabs = {}

local function setTab(name)
	for tabName, t in pairs(tabs) do
		local active = tabName == name
		t.page.Visible = active
		t.underline.Visible = active
		TweenService:Create(t.button, tweenInfo, {
			TextColor3 = active and TAB_ACTIVE or TAB_INACTIVE
		}):Play()
	end
end

local TAB_COUNT = 3

local function createTab(name, text, index, page)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1 / TAB_COUNT, 0, 1, 0)
	button.Position = UDim2.fromScale((index - 1) / TAB_COUNT, 0)
	button.BackgroundTransparency = 1
	button.Text = text
	button.TextColor3 = TAB_INACTIVE
	button.Font = Enum.Font.GothamBold
	button.TextSize = 13
	button.AutoButtonColor = false
	button.Parent = tabBar

	local underline = Instance.new("Frame")
	underline.AnchorPoint = Vector2.new(0.5, 1)
	underline.Position = UDim2.new(0.5, 0, 1, 0)
	underline.Size = UDim2.new(0.7, 0, 0, 2)
	underline.BackgroundColor3 = ON_COLOR
	underline.BorderSizePixel = 0
	underline.Visible = false
	underline.Parent = button

	tabs[name] = { button = button, underline = underline, page = page }

	button.Activated:Connect(function()
		setTab(name)
	end)
end

